{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/server.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-corp-actions",
      "schedule": "30 2 * * *"
    }
  ]
}
